{
  "name": "startup-factory-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Intro out/startup-factory-intro.mp4 --codec h264 --crf 18",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" package.json tsconfig.json && tsc --noEmit",
    "still": "remotion still src/index.ts Intro out/poster.png --frame 300",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" package.json tsconfig.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "^3.9.6",
    "typescript": "5.9.3"
  }
}
